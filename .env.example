# Copy to .env.local; use the dedicated database login you created locally.
# HARNESS_API_TOKEN must be at least 32 printable ASCII characters.
HARNESS_DATABASE_URL=postgresql://agent_harness_local:replace-me@127.0.0.1:5432/agent_harness
HARNESS_TEST_DATABASE_URL=postgresql://agent_harness_local:replace-me@127.0.0.1:5432/agent_harness_test
HARNESS_API_TOKEN=
